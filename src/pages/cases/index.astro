---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('cases')).sort(
  (a, b) => a.data.order - b.data.order
);
---
<BaseLayout
  title="시공사례 | DEPIDA"
  description="호텔·리조트, 풀빌라·펜션, 찜질방·사우나, 관공서 등 DEPIDA 전기온돌 난방 시스템의 실제 시공 포트폴리오를 확인하세요."
  keywords="DEPIDA 시공사례, 전기온돌 시공, 바닥난방 포트폴리오, 정진테크"
>
  <div class="container">
    <main style="max-width:1200px; margin:0 auto; padding:120px 32px; font-family:sans-serif; color:#333;">
      <section style="margin-bottom:60px;">
        <p style="font-size:0.95rem; letter-spacing:0.08em; color:#9b7b58; margin-bottom:18px; font-weight:600;">PORTFOLIO</p>
        <h1 style="font-size:3rem; font-weight:700; line-height:1.35; color:#111; margin-bottom:20px;">시공사례</h1>
        <div style="width:100px; height:2px; background:#c49a6c;"></div>
      </section>

      <section style="display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:32px;">
        {entries.map((entry) => (
          <a href={`/cases/${entry.id}/`} class="depida-card" style="display:block; text-decoration:none; color:inherit;">
            {entry.data.items[0]?.image && (
              <div style="width:100%; height:220px; background:#e8e1d8; overflow:hidden;">
                <img src={entry.data.items[0].image} alt={entry.data.heading} style="width:100%; height:100%; object-fit:cover; display:block;" />
              </div>
            )}
            <div style="padding:32px 30px;">
              <p class="depida-card-label">{entry.data.label}</p>
              <h3 class="depida-card-title">{entry.data.heading}</h3>
              <div class="depida-card-more">사례 보기 +</div>
            </div>
          </a>
        ))}
      </section>
    </main>
  </div>
</BaseLayout>
